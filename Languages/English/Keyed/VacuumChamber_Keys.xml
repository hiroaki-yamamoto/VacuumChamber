<LanguageData>

  <!-- Gizmos -->
  <VC_SetVacuumLevel_Label>Target vacuum: {0}%</VC_SetVacuumLevel_Label>
  <VC_SetVacuumLevel_Desc>Open a dialog to set the target vacuum level (0% to 100%) for this chamber. Depressurizes when current vacuum is below the target, and pressurizes when above it.</VC_SetVacuumLevel_Desc>
  <VC_SetPumpingSpeed_Label>Pumping speed: Lv {0}</VC_SetPumpingSpeed_Label>
  <VC_SetPressurizationSpeed_Label>Pressurization speed: Lv {0}</VC_SetPressurizationSpeed_Label>
  <VC_SetPumpingSpeed_Desc>Open a dialog to set the pumping speed level (1 to 50), which serves as the pressurization speed level when current vacuum exceeds the target. Each level adds 100 m³/h flow rate and consumes 250 W.</VC_SetPumpingSpeed_Desc>

  <!-- Dialog -->
  <VC_Dialog_TargetVacuumTitle>Set Target Vacuum Level</VC_Dialog_TargetVacuumTitle>
  <VC_Dialog_PumpingSpeedTitle>Set Pumping Speed Level</VC_Dialog_PumpingSpeedTitle>
  <VC_Dialog_PressurizationSpeedTitle>Set Pressurization Speed Level</VC_Dialog_PressurizationSpeedTitle>
